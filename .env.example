# WebStats Docker Compose 环境变量样例
# 用法：cp .env.example .env  然后按需修改（.env 已被 .gitignore 忽略，不会提交）

# ---- 对外端口（宿主机端口 → 容器 80）----
HTTP_PORT=8080

# ---- 镜像版本（ghcr.io/kfwcc/wstats:<tag>；本地构建可保持 latest）----
WSTAT_IMAGE_TAG=latest

# ---- 时区（影响 PHP 时间、cron 的 03:00/04:00 任务）----
WSTAT_TZ=Asia/Shanghai

# ---- 数据库 ----
WSTAT_DB_HOST=db
WSTAT_DB_NAME=webstats
WSTAT_DB_USER=webstats
WSTAT_DB_PASS=wstats_pwd
# MySQL root 口令（仅 compose 内使用）
MYSQL_ROOT_PASSWORD=wstats_root_pwd
# 应用账号无建库权限时，安装用它建库（一般留空）
WSTAT_INSTALL_DB_USER=
WSTAT_INSTALL_DB_PASS=

# ---- Redis（WSTAT_NO_REDIS=1 可整体关闭，走 MySQL 直写降级模式）----
WSTAT_REDIS_HOST=redis
WSTAT_REDIS_DB=0
WSTAT_REDIS_AUTH=
WSTAT_NO_REDIS=0

# ---- 首次启动自动安装（1=开）----
WSTAT_AUTO_INSTALL=1
WSTAT_ADMIN_EMAIL=admin@example.com
WSTAT_ADMIN_PASS=Admin@12345
# 安装后是否允许开放注册（0=关闭，仅管理员建号，推荐）
WSTAT_ALLOW_REGISTER=0

# ---- 采集与更新开关（可选）----
# WSTAT_DEBUG=0
# WSTAT_ALLOW_UNVERIFIED=0
# WSTAT_UPDATE_URL=https://wstats-update.kfw.cc/update.php
